{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.3",
  "agents": {
    "explore": {
      "model": "github-copilot/gpt-6-luna"
    },
    "title": {
      "model": "github-copilot/gpt-6-luna"
    }
  },
  "permissions": [
    {
      "action": "read",
      "resource": "*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.*",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.credentials.json",
      "effect": "deny"
    },
    {
      "action": "read",
      "resource": "*.env.example",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git push *",
      "effect": "ask"
    }
  ],
  "plugin": [
    "@slkiser/opencode-quota@5.0.2"
  ],
  "provider": {
    "copilot": {},
    "zai": {}
  }
}
