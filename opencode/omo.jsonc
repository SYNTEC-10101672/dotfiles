// OMO configuration
// Deployed as ~/.omo/omo.jsonc (symlink via `make opencode`).
// OmO >= 4.19 reads this as the only config source; the legacy
// ~/.config/opencode/oh-my-openagent.json is no longer part of the config chain.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "claude_code": {
      "plugins": false,
      "skills": false,
      "commands": false,
      "hooks": false
    },
    "agents": {
      "sisyphus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "oracle": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "explore": {
        "model": "github-copilot/gpt-5.6-luna",
        // NOTE: fallback_models is deprecated upstream, but 4.19.4's own
        // suggested replacement (`models` array) is rejected by its validator
        // (code-yeongyu/oh-my-openagent#6606). Keep fallback_models until fixed.
        "fallback_models": [
          "zai-coding-plan/glm-4.7"
        ]
      },
      "librarian": {
        "model": "github-copilot/gpt-5.6-luna",
        "fallback_models": [
          "zai-coding-plan/glm-4.7"
        ]
      },
      "multimodal-looker": {
        "model": "github-copilot/gpt-5-mini"
      },
      "prometheus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "metis": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "momus": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "atlas": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "sisyphus-junior": {
        "model": "zai-coding-plan/glm-5.3"
      }
    },
    "categories": {
      "visual-engineering": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "ultrabrain": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "deep": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "artistry": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "quick": {
        "model": "github-copilot/gpt-5.6-luna"
      },
      "unspecified-low": {
        "model": "github-copilot/gpt-5.6-luna"
      },
      "unspecified-high": {
        "model": "zai-coding-plan/glm-5.3"
      },
      "writing": {
        "model": "zai-coding-plan/glm-5.3"
      }
    }
  },
  "_migrations": [
    "2026-07-opencode-config-unification"
  ]
}
