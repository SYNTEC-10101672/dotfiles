{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "gruvbox"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "keybinds": {
    "leader": "ctrl+\\",
    "session.list": "<leader>p",
    "pane.focus.left": "<leader>h,<leader>left",
    "pane.focus.right": "<leader>l,<leader>right"
  },
  "animations": true
}
